        {
          "name": "weather.forecast",
          "tier": "auto",
          "ownerOnly": false,
          "description": "The forecast day by day for one of the owner's places (home when none is named) or any city, up to 7 days: high, low, sky, rain and strong wind. Use it before suggesting anything outdoors or when the owner asks about the coming days."
        },
        {
          "name": "weather.places",
          "tier": "auto",
          "ownerOnly": false,
          "description": "The places the owner saved for the weather, which one is home, and the units they read."
