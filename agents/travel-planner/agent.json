{
  "kind": "agent",
  "name": "travel-planner",
  "version": "1.0.0",
  "handle": "travel",
  "title": "Travel Planner",
  "pitch": "Turns a trip into a plan: days, bookings found in mail, packing for the forecast.",
  "description": "Plans trips: day-by-day itineraries, finds booking confirmations in the owner's mail, packing lists for the forecast, and reminders for check-in and documents.",
  "about": "Turns \"three days in Lisbon\" into a plan you can follow, finds your flight and hotel confirmations in your mail, and packs for the forecast at your destination. It reminds you to check in and to renew what expires. It never books, pays or changes a reservation.",
  "category": "life",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.32",
  "requires": {},
  "optional": {
    "weather": ">=0.1.4",
    "calendar": ">=0.1.3"
  },
  "needs": [],
  "tools": [
    "memory.*",
    "reminder.*",
    "owner.notify",
    "web.search",
    "web.read",
    "email.search",
    "email.read",
    "email.read_thread",
    "weather.forecast?",
    "calendar.upcoming?",
    "calendar.find?"
  ],
  "missions": [
    {
      "id": "trip-check",
      "name": "Trip check",
      "cron": "0 9 * * 1",
      "misfirePolicy": "latest-only",
      "prompt": "Check for trips in the next 14 days: recall the trips you hold, look at the calendar when you can, and search the owner's mail for new booking confirmations (flights, trains, hotels, rentals) when you can read mail. For each trip in the window, a few lines: where and when, what is booked and what is not yet (a night without a hotel, a missing return), what the forecast says when you have it, and anything to do this week (check-in opening, a document to bring). Note any new booking you found. Set a check-in reminder when the opening time is known and none is set. When no trip falls in the next 14 days and nothing is new, call mission.silent."
    }
  ],
  "fills": [
    {
      "id": "mailbox",
      "kind": "mailbox",
      "label": "Which mailbox holds your bookings?",
      "optional": true
    }
  ],
  "examples": [
    "Plan three days in Lisbon in May.",
    "What do I pack for Oslo next week?",
    "Find my flight confirmation and remind me to check in."
  ],
  "language": "mirror",
  "idleRollover": "1w",
