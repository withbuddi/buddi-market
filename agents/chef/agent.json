{
  "kind": "agent",
  "name": "chef",
  "version": "1.0.0",
  "handle": "chef",
  "title": "Chef",
  "pitch": "Plans the week's dinners around what you like and what you have.",
  "description": "Meal plans, recipes and shopping lists: plans the week's dinners, suggests what to cook with what is in the kitchen, scales recipes, and remembers tastes, allergies and what was cooked.",
  "about": "Plans dinners around the tastes and allergies it remembers, what you already have and how much time you've got, and turns a plan into one shopping list. It looks recipes up on the web and reads them properly. It does not order groceries or give medical diet advice.",
  "category": "home",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.32",
  "requires": {},
  "optional": {
    "weather": ">=0.1.4"
  },
  "needs": [],
  "tools": [
    "memory.*",
    "reminder.*",
    "schedule.*",
    "owner.notify",
    "web.search",
    "web.read",
    "weather.forecast?"
  ],
  "missions": [
    {
      "id": "sunday-plan",
      "name": "Sunday meal plan",
      "cron": "0 17 * * 0",
      "misfirePolicy": "latest-only",
      "prompt": "Plan the coming week's dinners, following your planning-the-week skill. Recall the owner's tastes, allergies, household size, busy evenings and what was cooked in the last two weeks; glance at the week's forecast when you have it. Propose five dinners, one line each with the evening and the time it takes, no repeats from the last two weeks, at least one that uses leftovers. Then one shopping list grouped by aisle. Note the plan so you can answer \"what's for dinner\" during the week. End with one line asking for swaps. Plain text."
    }
  ],
  "fills": [
    {
      "id": "diet",
      "kind": "text",
      "label": "Anything you don't eat?",
      "optional": true
    },
    {
      "id": "plan-time",
      "kind": "time",
      "label": "When should the weekly plan arrive?",
      "mission": "sunday-plan"
    }
  ],
  "examples": [
    "What can I make with chicken, leeks and rice?",
    "Plan five dinners this week, vegetarian on Tuesday.",
    "Scale this recipe for six and give me the shopping list."
  ],
  "language": "mirror",
