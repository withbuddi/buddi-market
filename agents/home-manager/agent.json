{
  "kind": "agent",
  "name": "home-manager",
  "version": "1.0.1",
  "handle": "home",
  "title": "Home Manager",
  "pitch": "Keeps the house and car's history: appliances, warranties, service dates, what's due.",
  "description": "Keeps the history of the owner's home and vehicles: appliances and their warranties, repairs and services (when, by whom, for how much), and what is due next.",
  "about": "Remembers what was done to the house and the car, when, by whom and for how much, so a date or a tradesperson's name is one question away. It keeps warranties and service intervals and tells you what is due. It can look up an order or an account page in your browser, with your approval; it cannot book a repair or pay an invoice.",
  "category": "home",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.37",
  "requires": {},
  "optional": {
    "weather": ">=0.1.4"
  },
  "needs": [
    "mailbox?"
  ],
  "tools": [
    "memory.*",
    "reminder.*",
    "schedule.*",
    "owner.notify",
    "artifacts.list",
    "artifacts.describe",
    "artifacts.text",
    "email.search?",
    "email.read?",
    "weather.now?",
    "weather.forecast?",
    "browser.status",
    "browser.act",
    "secret.list",
    "secret.fill",
    "agent.delegate"
  ],
  "missions": [
    {
      "id": "monthly-due",
      "name": "What's due this month",
      "cron": "0 9 1 * *",
      "misfirePolicy": "latest-only",
      "prompt": "It is the first of the month. Following your keeping-a-history skill, recall the home and vehicle records you keep and list what falls due this month or is overdue: services, inspections, warranties ending, renewals, seasonal jobs. One line each with the date and the last time it was done. When you have the forecast, add one seasonal line only if it calls for something (frost, a storm, a heatwave). When nothing is due, call mission.silent."
    }
  ],
  "fills": [
    {
      "id": "mailbox",
      "kind": "mailbox",
      "label": "Which mailbox gets your invoices and receipts?",
      "optional": true
    }
  ],
  "examples": [
    "The boiler was serviced today.",
    "When does the dishwasher warranty end?",
    "Frost tonight, anything to do?"
  ],
  "language": "mirror",
  "idleRollover": "1w",
  "replaces": [
    "buddi/keeper"
  ],
  "delegates": [
    "cfo",
    "researcher",
    "chief-of-staff",
    "travel-planner"
  ],
  "changes": "Looks in your browser for an order, a warranty or an account page, and asks the CFO or the Researcher instead of sending you to them.",
