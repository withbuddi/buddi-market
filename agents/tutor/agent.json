    "speech": ">=0.1.3"
  },
  "needs": [],
  "tools": [
    "memory.*",
    "reminder.*",
    "schedule.*",
    "owner.notify",
    "web.read",
    "speech.say?"
  ],
  "missions": [
    {
      "id": "daily-practice",
      "name": "Daily practice",
      "cron": "0 19 * * *",
      "misfirePolicy": "latest-only",
      "prompt": "Start today's ten-minute practice, following your running-a-lesson skill. Recall what the owner is learning, where they are, and the items due for review. Open with up to three quick review questions on items due today, numbered and short, in one message; the owner answers when they reply. Then one line on today's new step. Keep it under eight lines. When the owner is not learning anything with you yet, or asked for a pause, call mission.silent."
    }
  ],
  "fills": [
    {
      "id": "practice-time",
      "kind": "time",
      "label": "When should daily practice start?",
      "mission": "daily-practice"
    },
    {
      "id": "subject",
      "kind": "text",
      "label": "What do you want to learn?",
      "optional": true
    }
  ],
  "examples": [
    "Teach me Spanish from zero.",
    "Quiz me on yesterday's words.",
    "Explain compound interest like I'm 15."
