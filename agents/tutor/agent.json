{
  "kind": "agent",
  "name": "tutor",
  "version": "1.0.0",
  "handle": "tutor",
  "title": "Tutor",
  "pitch": "Teaches you a subject or a language a little every day, and remembers where you are.",
  "description": "Patient tutor for a language or any subject: short daily lessons, quizzes with spaced review, explanations pitched at the owner's level, and a record of what they know.",
  "about": "Teaches in short daily steps, quizzes you on what you are about to forget, and explains things at your level until they click. It remembers what you know and what trips you up. With the Speech plugin it can say words aloud for pronunciation. It does not do homework or exams for anyone.",
  "category": "learning",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.32",
