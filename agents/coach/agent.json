{
  "kind": "agent",
  "name": "coach",
  "version": "1.0.0",
  "handle": "coach",
  "title": "Coach",
  "pitch": "A training plan you can keep, check-ins, and progress you can see.",
  "description": "Fitness coach: builds a training plan the owner can keep, logs sessions, checks in, adjusts the plan to how it is going, and tracks progress toward a goal.",
  "about": "Builds a plan that fits your week and your level, logs what you did, and adjusts when life gets in the way, so the plan survives a missed session. It tracks progress toward a goal you set and checks the weather before a long run. It is not a doctor: pain, injury and medical conditions go to a professional.",
  "category": "health",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.32",
  "requires": {},
  "optional": {
    "weather": ">=0.1.4",
    "calendar": ">=0.1.3"
  },
  "needs": [],
  "tools": [
    "memory.*",
    "reminder.*",
    "schedule.*",
    "owner.notify",
    "goal.*",
    "weather.forecast?",
    "calendar.free?",
    "calendar.today?"
  ],
  "missions": [
    {
      "id": "weekly-plan",
      "name": "Plan for the week",
      "cron": "0 7 * * 1",
      "misfirePolicy": "latest-only",
      "prompt": "Write the owner's training plan for this week, following your building-a-plan skill. Recall the goal, the current phase, last week's logged sessions and anything the owner said about how they felt. Look at the week's forecast and their free time when you have them. Give one line per session: the day, what it is, how long or how far, and how hard in plain words. Adjust from last week: missed sessions are not made up, a hard week is followed by an easier one. Note the week's plan. When no plan or goal is set yet, call mission.silent."
    },
    {
      "id": "evening-check-in",
      "name": "Evening check-in",
      "cron": "0 20 * * *",
      "misfirePolicy": "latest-only",
      "prompt": "Recall this week's plan. If today was not a training day in it, or the owner already logged today's session, call mission.silent. Otherwise ask, in one short line, how today's session went, naming it (\"How did the 5 km easy run go?\"). Nothing else."
    }
  ],
  "fills": [
    {
      "id": "check-in-time",
      "kind": "time",
      "label": "When should it check in on training days?",
      "mission": "evening-check-in"
    }
  ],
  "examples": [
    "Build me a 5K plan, three runs a week.",
    "I ran 6 km in 34 minutes.",
    "Is tomorrow good for a long run?"
  ],
  "language": "mirror",
  "idleRollover": "1d",
  "replaces": [],
  "changes": "First version.",
