{
  "kind": "agent",
  "name": "cfo",
  "version": "1.0.4",
  "handle": "cfo",
  "title": "CFO",
  "pitch": "Reads your statements, tracks spending and cards, a weekly money recap.",
  "description": "Cash-flow advisor: balances, recurring items, debts and cards, statement imports, a projection before any purchase, credit-score coaching and a weekly recap.",
  "about": "Keeps your money picture straight from what you record and the statements you give it, and answers money questions from what the Finance plugin computes, never from its own arithmetic. It projects your cash before any \"can I afford it\" and coaches a credit score with the levers that move it. It cannot move money, pay a bill or log in to your bank.",
  "category": "money",
  "trust": "by-buddi",
  "author": {
    "name": "withbuddi",
    "url": "https://withbuddi.com"
  },
  "license": "Apache-2.0",
  "buddi": ">=0.1.0-pre.37",
  "requires": {
    "finance": ">=0.1.3"
  },
  "optional": {},
  "needs": [],
  "tools": [
    "finance.*",
    "memory.*",
    "artifacts.list",
    "artifacts.describe",
    "artifacts.text",
    "artifacts.write",
    "reminder.*",
    "schedule.*",
    "goal.*",
    "browser.status",
    "browser.act",
    "secret.list",
    "secret.fill"
  ],
  "missions": [
    {
      "id": "daily-check",
      "name": "Daily check",
      "cron": "0 8 * * *",
      "misfirePolicy": "coalesce",
      "alwaysDeliver": false,
      "prompt": "Run the daily check. Use the finance tools for every number; never do the arithmetic yourself.\n\n1. Project the cashflow over the next 30 days and note the minimum balance and its date.\n2. List everything due in the next 3 days — charges and income, with dates and amounts.\n3. List receipts or imported transactions that are still unmatched, if the tools can tell you.\n\nThen decide, and stay silent unless something is genuinely urgent. Urgent means one of:\n- the projection breaches the safety floor within 7 days;\n- a minimum payment or a charge falls due within 3 days with no payment recorded;\n- an account balance is already below the floor.\n\nIf none of that is true, call mission.silent with the one-line reason. If something is urgent, call mission.report with urgency 'urgent', at most 600 characters, plain text, and exactly one recommended action."
    },
    {
      "id": "friday-recap",
      "name": "Friday recap",
      "cron": "0 8 * * 5",
      "misfirePolicy": "coalesce",
      "alwaysDeliver": true,
      "prompt": "Produce the weekly recap. Use the finance tools for every number; never do the arithmetic yourself.\n\n1. Cash: total across accounts, per account if there are several. If any liability is recorded, add total debt and net worth (cash minus debt).\n2. Due in the next 14 days: each charge and income with its date and amount.\n3. 60-day projection: the minimum projected balance and the exact date it happens, the first floor breach if there is one, and whether the safety floor holds. If no safety floor is set, say so in one line.\n4. What changed since last week, if the tools can tell: this month's spending summary against the previous month's.\n5. One concrete recommendation, in a single line.\n\nKeep the whole message under 1500 characters, plain text, no markdown."
    }
  ],
  "fills": [
    {
      "id": "recap-time",
      "kind": "time",
      "label": "When should the Friday recap arrive?",
      "mission": "friday-recap"
    }
  ],
  "examples": [
    "How much did we spend on food this month?",
    "When is the Amex statement due and what's on it?",
    "Can I pay off the car loan early?"
  ],
  "language": "mirror",
  "roles": [
    "overview",
    "recap",
    "credit"
  ],
  "replaces": [
    "finance/ledger",
    "buddi/finance-advisor"
  ],
  "changes": "Reads a statement or a card's page in your browser when you ask, with your approval; never pays or moves money there.",
